---
const services = [
	{
		title: 'Kitchen Remodeling',
		body: 'Your kitchen is where your home actually lives. We design spaces that work the way you do: better storage, smarter layout, and finishes that last.',
		investment: '$28,000–$100,000',
		cta: 'See Kitchen Projects',
		accent: 'primary',
		svg: `<path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/><path d="M3 9V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3"/><path d="M12 12v5M9 12v3M15 12v3"/>`,
	},
	{
		title: 'Bathroom Remodeling',
		body: 'A bathroom remodel delivers some of the highest ROI of any home improvement. We build showers, vanities, and tile work that look custom because they are.',
		investment: '$16,000–$65,000',
		cta: 'See Bathroom Projects',
		accent: 'accent',
		svg: `<path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><path d="M18 12H4"/><path d="M15 6a3 3 0 0 1 3 3"/>`,
	},
	{
		title: 'Home Additions',
		body: 'Need more space without moving? We design and build additions that match your home\'s existing architecture, seamlessly.',
		investment: '$45,000–$200,000+',
		cta: 'Plan My Addition',
		accent: 'primary',
		svg: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><path d="M15 7h4v4"/>`,
	},
	{
		title: 'Whole Home Remodeling',
		body: 'Ready to transform the entire home? We coordinate all trades, timelines, and finishes under one fixed-price contract.',
		investment: '$75,000–$350,000+',
		cta: 'Start My Project',
		accent: 'accent',
		svg: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M7 8h10M7 11h6"/>`,
	},
];
---

<section class="services" aria-labelledby="services-headline">
	<div class="container-site services__inner">

		<!-- Left: image + header overlay -->
		<div class="services__image-col">
			<div class="services__image-wrap">
				<img
					src="/Raleigh's Remodeling Specialists.png"
					alt="Raleigh's Remodeling Specialists — Oak and Stone"
					class="services__image"
					width="600"
					height="700"
					loading="lazy"
				/>
				<div class="services__image-overlay" aria-hidden="true"></div>
				<div class="services__image-badge">
					<p class="services__eyebrow">What We Build</p>
					<h2 id="services-headline" class="services__headline">
						Raleigh's Remodeling Specialists
					</h2>
					<p class="services__sub">
						From a single bathroom to a complete whole-home transformation, we handle every phase from design through final walkthrough.
					</p>
				</div>
			</div>
		</div>

		<!-- Right: cards with connector -->
		<div class="services__cards-col">
			<div class="services__track" aria-hidden="true"></div>
			{services.map(s => (
				<div class="services__item">
					<div class={`services__dot services__dot--${s.accent}`} aria-hidden="true">
						<div class="services__dot-inner"></div>
					</div>
					<div class={`services__card services__card--${s.accent}`}>
						<div class={`services__card-icon services__card-icon--${s.accent}`}>
							<svg aria-hidden="true" viewBox="0 0 24 24" set:html={s.svg} />
						</div>
						<div class="services__card-body">
							<h3 class="services__card-title">{s.title}</h3>
							<p class="services__card-text">{s.body}</p>
							<div class="services__card-footer">
								<span class="services__investment">
									<span class="services__investment-label">
										<svg aria-hidden="true" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
										Typical Investment
									</span>
									<strong class="services__investment-value">{s.investment}</strong>
								</span>
								<a href="#estimate" class={`services__cta services__cta--${s.accent}`}>
									{s.cta}
									<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
								</a>
							</div>
						</div>
					</div>
				</div>
			))}
		</div>

	</div>
</section>
