---
const items = [
	{
		number: '01',
		title: 'Labor',
		body: 'All crew, project management, and specialty subcontractors',
		svg: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>`,
	},
	{
		number: '02',
		title: 'Materials',
		body: 'Cabinetry, tile, countertops, fixtures, and finishes at your selected tier',
		svg: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`,
	},
	{
		number: '03',
		title: 'Design & Planning',
		body: '3D rendering, layout planning, and material selection sessions',
		svg: `<path d="M2 12h20M12 2v20"/><rect x="7" y="7" width="10" height="10" rx="1"/>`,
	},
	{
		number: '04',
		title: 'Permits',
		body: 'All required city and county permits for Raleigh and surrounding areas',
		svg: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/>`,
	},
	{
		number: '05',
		title: 'Site Prep & Protection',
		body: 'Floor protection, dust barriers, and full daily cleanup',
		svg: `<path d="M12 3 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/>`,
	},
	{
		number: '06',
		title: 'Post-Project Walkthrough',
		body: 'Punch list review and 2-year workmanship warranty activation',
		svg: `<path d="M20 6L9 17l-5-5"/>`,
	},
];
---

<section class="includes" aria-labelledby="includes-headline">
	<div class="container-site includes__inner">

		<!-- Header -->
		<div class="includes__header">
			<p class="includes__eyebrow">Full Transparency</p>
			<h2 id="includes-headline" class="includes__headline">
				No Hidden Line Items.<br />Here's Exactly What We Price In.
			</h2>
			<p class="includes__sub">
				Most contractors quote low, then add costs once work begins. We price everything upfront — so your proposal is your final number.
			</p>
		</div>

		<!-- Six items grid -->
		<div class="includes__grid">
			{items.map(item => (
				<div class="includes__card">
					<div class="includes__card-top">
						<span class="includes__num">{item.number}</span>
						<span class="includes__icon">
							<svg aria-hidden="true" viewBox="0 0 24 24" set:html={item.svg} />
						</span>
					</div>
					<h3 class="includes__card-title">{item.title}</h3>
					<p class="includes__card-body">{item.body}</p>
				</div>
			))}
		</div>

		<!-- Bottom disclaimer -->
		<div class="includes__disclaimer">
			<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
			<p>Every Oak &amp; Stone proposal is a fixed-price commitment — what we quote is what you pay. No change orders for items already in scope.</p>
		</div>

	</div>
</section>
