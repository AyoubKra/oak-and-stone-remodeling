---
const steps = [
	{
		num: '01',
		title: 'Free On-Site Consultation',
		body: 'We visit your home, review your goals, and answer every question. No pitch, no pressure.',
		svg: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>`,
	},
	{
		num: '02',
		title: 'Design & Planning',
		body: 'We create a 3D rendering of your project so you can see it before we build it. Materials are selected, timeline is set.',
		svg: `<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>`,
	},
	{
		num: '03',
		title: 'Fixed-Price Proposal',
		body: 'You receive a single all-in number: labor, materials, permits, everything. That number does not change.',
		svg: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/>`,
	},
	{
		num: '04',
		title: 'Construction',
		body: 'Our crew arrives on schedule, works cleanly, and sends you daily photo updates. You always know what\'s happening.',
		svg: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>`,
	},
	{
		num: '05',
		title: 'Final Walkthrough & Warranty',
		body: 'We walk every inch of the project together. Nothing is closed out until you\'re fully satisfied. Then your 2-year warranty activates.',
		svg: `<path d="M12 3 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>`,
	},
];
---

<section class="process" aria-labelledby="process-headline">
	<div class="container-site process__inner">

		<div class="process__header">
			<p class="process__eyebrow">How It Works</p>
			<h2 id="process-headline" class="process__headline">What Happens After You Request an Estimate</h2>
			<p class="process__sub">No surprises. No mystery. Just a clear process from day one.</p>
		</div>

		<!-- Horizontal steps -->
		<div class="process__track-wrap">
			<!-- Connecting line behind icons -->
			<div class="process__line" aria-hidden="true"></div>

			<div class="process__steps">
				{steps.map((step) => (
					<div class="process__step">
						<!-- Icon circle -->
						<div class="process__icon-wrap">
							<div class={`process__icon${step.num === '03' ? ' process__icon--accent' : ''}`}>
								<svg aria-hidden="true" viewBox="0 0 24 24" set:html={step.svg} />
							</div>
							<span class="process__num">{step.num}</span>
						</div>
						<!-- Text below -->
						<div class="process__step-body">
							<h3 class="process__step-title">{step.title}</h3>
							<p class="process__step-text">{step.body}</p>
						</div>
					</div>
				))}
			</div>
		</div>

	</div>
</section>
