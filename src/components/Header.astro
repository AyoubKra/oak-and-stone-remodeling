---
const navLinks = [
	{ label: 'Services',        href: '#services' },
	{ label: 'Get an Estimate', href: '#estimate' },
	{ label: 'Gallery',         href: '#gallery' },
	{ label: 'Reviews',         href: '#reviews' },
	{ label: 'FAQ',             href: '#faq' },
];
---

<div class="demo-bar">
	Demo only — portfolio concept site, not a real business.
</div>

<header class="site-header" id="site-header">
	<div class="container-site site-header__inner">

		<!-- Logo -->
		<a href="/" class="site-header__logo" aria-label="Oak and Stone Remodeling home">
			<span>Oak &amp; Stone</span>
			<strong>Remodeling</strong>
		</a>

		<!-- Desktop nav -->
		<nav class="site-header__nav" aria-label="Main navigation">
			<ul class="site-header__nav-list">
				{navLinks.map(link => (
					<li>
						<a href={link.href} class="site-header__nav-link">{link.label}</a>
					</li>
				))}
			</ul>
		</nav>

		<!-- Desktop right: phone + CTA -->
		<div class="site-header__actions">
			<a href="tel:+19190000000" class="site-header__phone" aria-label="Call us">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19 19 0 0 1-8.3-3 18.7 18.7 0 0 1-5.8-5.8 19 19 0 0 1-3-8.3A2 2 0 0 1 4.7 2h3a2 2 0 0 1 2 1.7l.4 2.7a2 2 0 0 1-.6 1.8L8.2 9.5a16 16 0 0 0 6.3 6.3l1.3-1.3a2 2 0 0 1 1.8-.6l2.7.4a2 2 0 0 1 1.7 2Z"/>
				</svg>
				(919) XXX-XXXX
			</a>
			<a href="#estimate" class="btn btn-primary site-header__cta">
				Get My Free Estimate
			</a>
		</div>

		<!-- Mobile hamburger -->
		<button
			class="site-header__hamburger"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>

	<!-- Mobile nav drawer -->
	<div class="site-header__mobile-nav" id="mobile-nav" aria-hidden="true">
		<nav aria-label="Mobile navigation">
			<ul class="site-header__mobile-list">
				{navLinks.map(link => (
					<li>
						<a href={link.href} class="site-header__mobile-link">{link.label}</a>
					</li>
				))}
			</ul>
			<div class="site-header__mobile-footer">
				<a href="tel:+19190000000" class="site-header__mobile-phone">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19 19 0 0 1-8.3-3 18.7 18.7 0 0 1-5.8-5.8 19 19 0 0 1-3-8.3A2 2 0 0 1 4.7 2h3a2 2 0 0 1 2 1.7l.4 2.7a2 2 0 0 1-.6 1.8L8.2 9.5a16 16 0 0 0 6.3 6.3l1.3-1.3a2 2 0 0 1 1.8-.6l2.7.4a2 2 0 0 1 1.7 2Z"/>
					</svg>
					(919) XXX-XXXX
				</a>
				<a href="#estimate" class="btn btn-primary" style="width:100%; justify-content:center;">
					Get My Free Estimate
				</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const header     = document.getElementById('site-header')!;
	const hamburger  = header.querySelector('.site-header__hamburger') as HTMLButtonElement;
	const mobileNav  = document.getElementById('mobile-nav')!;

	// Sticky shadow on scroll
	window.addEventListener('scroll', () => {
		header.classList.toggle('site-header--scrolled', window.scrollY > 10);
	}, { passive: true });

	// Toggle mobile menu
	hamburger.addEventListener('click', () => {
		const open = hamburger.getAttribute('aria-expanded') === 'true';
		hamburger.setAttribute('aria-expanded', String(!open));
		mobileNav.setAttribute('aria-hidden', String(open));
		hamburger.classList.toggle('is-open', !open);
		mobileNav.classList.toggle('is-open', !open);
		document.body.classList.toggle('nav-open', !open);
	});

	// Close on nav link click
	mobileNav.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			hamburger.setAttribute('aria-expanded', 'false');
			mobileNav.setAttribute('aria-hidden', 'true');
			hamburger.classList.remove('is-open');
			mobileNav.classList.remove('is-open');
			document.body.classList.remove('nav-open');
		});
	});
</script>
