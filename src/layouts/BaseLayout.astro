---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- No indexing — portfolio demo site -->
		<meta name="robots" content="noindex, nofollow" />

		<!-- Primary SEO -->
		<title>Raleigh Remodeling Contractor | Free Cost Estimator | Oak & Stone Remodeling</title>
		<meta name="description" content="Get a free, instant remodeling cost estimate for your Raleigh kitchen, bathroom, or home addition. Fixed-price proposals, transparent pricing, no surprise costs." />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="See What Your Raleigh Remodel Could Cost — Free Estimator" />
		<meta property="og:description" content="Answer 8 quick questions and get a realistic project range in 60 seconds. No email required." />
		<meta property="og:locale" content="en_US" />

		<!-- Preload LCP image -->
		<link rel="preload" href="/hero-image.webp" as="image" type="image/webp" />

		<!-- Performance: preconnect for fonts (self-hosted, but preload the display font) -->
		<link rel="preload" href="/fonts/fraunces-v38-latin/fraunces-v38-latin-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/plus-jakarta-sans-v12-latin/plus-jakarta-sans-v12-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/plus-jakarta-sans-v12-latin/plus-jakarta-sans-v12-latin-600.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231D4ED8'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' font-size='18' font-family='serif' fill='white'>O</text></svg>" />

		<!-- Theme color -->
		<meta name="theme-color" content="#1D4ED8" />
	</head>
	<body>
		<slot />
	</body>
</html>
